    <script type="text/javascript" nonce="oUYJP2VG6tXUceqOK76eHOutLtk4kZVXmhgqRfKNBjI=">
        var embeddedColorScheme = window.self !== window.top
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;
        var hostColorScheme = null;

        function setColorScheme(theme) {
            var meta = document.querySelector('meta[name="color-scheme"]') || document.createElement('meta');
            meta.name = "color-scheme";
            meta.content = theme;
            document.getElementsByTagName('head')[0].appendChild(meta);
            if (theme === 'dark') {
                document.querySelector('body')?.classList.add('dark');
                document.querySelector('body')?.classList.remove('light');
            } else {
                document.querySelector('body')?.classList.add('light');
                document.querySelector('body')?.classList.remove('dark');
            }
        }
        //determines if the user has a set theme
        function detectColorScheme() {
            var theme = 'light'; //default to light
            var printview = false;            var params = new URLSearchParams(window.location.search);
            if (embeddedColorScheme || params.get('darkmode') === 'true') {
                if (!printview && !params.has('printview') && !window.matchMedia('print').matches) {
                    theme = params.get('darkmode') === 'true'
                        ? 'dark'
                        : hostColorScheme ?? (embeddedColorScheme?.matches ? 'dark' : 'light');
                }
                setColorScheme(theme);
                return;
            }
            if (window.localStorage && window.matchMedia && typeof Storage !== 'undefined' && typeof localStorage === 'object' && typeof localStorage.getItem === 'function') {
                const storageTheme = localStorage.getItem('theme');
                if (storageTheme) {
                    if (!printview && !window.matchMedia('print').matches && (storageTheme === 'dark' || (storageTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches))) {
                        theme = 'dark';
                    }
                } else {
                    localStorage.setItem('theme', 'light');
                }
            }
            setColorScheme(theme);
        }
        detectColorScheme();
        if (embeddedColorScheme) {
            window.addEventListener('message', function (event) {
                if (event.source !== window.parent || event.data?.type !== 'churchtools:color-scheme'
                    || (event.data.colorScheme !== 'light' && event.data.colorScheme !== 'dark')) {
                    return;
                }
                hostColorScheme = event.data.colorScheme;
                detectColorScheme();
            });
            window.parent.postMessage({ type: 'churchtools:request-color-scheme' }, '*');
            embeddedColorScheme.addEventListener('change', detectColorScheme);
            window.matchMedia('print').addEventListener('change', detectColorScheme);
            document.addEventListener('DOMContentLoaded', detectColorScheme);
        }
    </script>

